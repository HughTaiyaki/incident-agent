# Copy to deploy/.env. Credentials do not go here: see deploy/secrets/ in the deployment guide.

# Admission limit. 2 matches one serial worker and the 180-second deadline; see the guide.
INCIDENT_MAX_ACTIVE_RUNS=2
# maxmemory, and a container limit above it to leave room for the AOF rewrite fork.
INCIDENT_REDIS_MAXMEMORY=256mb
INCIDENT_REDIS_CONTAINER_MEMORY=512m

INCIDENT_MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
INCIDENT_MODEL_NAME=deepseek-flash
INCIDENT_MODEL_CONTEXT_WINDOW=1048576
INCIDENT_MODEL_API_PROFILE=deepseek

# Read-only telemetry. host.docker.internal reaches backends published on the host.
INCIDENT_PROMETHEUS_URL=http://host.docker.internal:9090
INCIDENT_LOKI_URL=http://host.docker.internal:3100
INCIDENT_JAEGER_URL=http://host.docker.internal:16686
